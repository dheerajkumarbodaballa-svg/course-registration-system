# PostgreSQL Connection (used for local development)
# On Render, the DATABASE_URL is set automatically when you link a PostgreSQL database.

# Option A: Single connection URL (Render sets this automatically)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: Individual variables (for local PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=course_registration
PGUSER=postgres
PGPASSWORD=postgres

# Server Port (Render sets PORT automatically)
PORT=3000
